      },
      "item": [
        {
          "id": "ae61517f-4cee-45c0-b00a-ed5ca51257bb",
          "name": "Search",
          "request": {
            "name": "Search",
            "description": {
              "content": "Search for available hotels based on input criteria.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "hotels-api",
                "availability"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "country_code",
                  "value": "<string>",
                  "description": "The country code of the traveler's point of sale, in ISO 3166-1 alpha-2 format. This should represent the country where the shopping transaction is taking place."
                },
                {
                  "disabled": false,
                  "key": "checkin_date",
                  "value": "<date>",
                  "description": "(Required) Refers to the hotel check-in date and must be in the format YYYY-MM-DD."
                },
                {
                  "disabled": false,
                  "key": "checkout_date",
                  "value": "<date>",
                  "description": "(Required) Refers to the hotel check-out date and must be in the format YYYY-MM-DD."
                },
                {
                  "disabled": false,
                  "key": "currency",
                  "value": "<string>",
                  "description": "(Required) Refers to the currency, which must be filled with three alphabetical digits. (E.g. \"USD\", \"ARS\")"
                },
                {
                  "disabled": false,
                  "key": "hotels",
                  "value": "<string>",
                  "description": "(Required) List of hotel IDs, separated by commas (max. 100)."
                },
                {
                  "disabled": false,
                  "key": "distribution",
                  "value": "<string>",
                  "description": "(Required) Passenger distribution. Each room’s passengers should be written as number_of_adults-children_ages. Children-age goes up to 17 years old. Rooms should be separated by “!”. E.g.: Means room 1 with 2 adults and room 2 with 2 adults and a 10-year-old child."
                },
                {
                  "disabled": false,
                  "key": "language",
                  "value": "<string>",
                  "description": "Refers to the language, which must be filled with two alphabetical digits."
                },
                {
                  "disabled": false,
                  "key": "ttl",
                  "value": "<integer>",
                  "description": "Maximum time allowed for the connection. Minimum = 3000 ms, Maximum = 6200 ms."
                },
                {
                  "disabled": false,
                  "key": "refundable_only",
                  "value": "<boolean>",
                  "description": "If set to ‘true’, only refundable hotel rates will be quoted."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
